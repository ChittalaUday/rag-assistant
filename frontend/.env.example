# Copy to frontend/.env (git-ignored). Only VITE_* variables reach the browser bundle.

# Where the Vite dev server proxies /api (the FastAPI backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Path or URL the UI calls. Keep /api in dev (proxied); set a full URL only if served separately.
VITE_API_BASE=/api

[Unit]
Description=Sleep idle model containers, wake them on demand
After=docker.service network-online.target
Requires=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/model-sleeper/sleeper.py
Environment=SLEEPER_CONFIG=/etc/model-sleeper.json
# Control API for other machines: set a secret and the listen address in a drop-in
# (sudo systemctl edit model-sleeper): Environment=SLEEPER_CONTROL_HOST=0.0.0.0 SLEEPER_TOKEN=...
EnvironmentFile=-/etc/model-sleeper.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# Copy to backend/.env (git-ignored). All values are read with the KE_ prefix.

# PostgreSQL on this machine only (loopback/unix socket is enforced). Create it with `make db-create`.
KE_DATABASE_URL=postgresql://localhost:5432/knowledge_engine
# Apply Alembic migrations automatically at startup.
KE_AUTO_MIGRATE=true

# Uploaded originals live here; keep it out of Git.
KE_DATA_DIR=./data

# Local model server (loopback only).
KE_OLLAMA_URL=http://127.0.0.1:11434
KE_CHAT_MODEL=qwen3.5:9b
# The embedding model (an Ollama model) is part of the index: when the model or its vector size
# changes, the next start replaces the vector column and re-embeds the documents automatically.
# embeddinggemma: best of seven models measured (docs/reports/engine-evaluation.md), multilingual.
KE_EMBEDDING_MODEL=embeddinggemma
# Vector size of that model.
KE_EMBEDDING_DIMENSIONS=768
# Task prefixes the model was trained with (change them with the model).
KE_EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
KE_EMBEDDING_QUERY_PREFIX="task: search result | query: "

# Cross-encoder reranker (an Ollama Qwen3-Reranker model; empty = feature ranking only) and its
# share of the final score.
KE_RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B:F16
KE_RERANK_WEIGHT=0.7
# One or two model-written sentences per passage that place it in its document, searched with it
# (one model call per passage at indexing, cached). KE_CONTEXT_MODEL empty = the chat model.
KE_CONTEXTUAL_CHUNKS=true
# KE_CONTEXT_MODEL=
# Second retrieval round following the names in the best passage: off | relationship | always.
KE_SECOND_HOP=always
# Map every answer sentence to the passages that state it (one model call per answer).
KE_VERIFY_CITATIONS=true
# Let the answer model reason before answering: about 10x slower on a 9B model.
KE_ANSWER_THINKING=false
# Resolve "she"/"that" in follow-up questions with one extra small model call.
KE_REWRITE_FOLLOWUPS=true
# Evidence budget (characters) in the answer prompt and target chunk size.
KE_CONTEXT_CHARS=9000
KE_CHUNK_CHARS=700
# Notice prepended to answers that cite a document carrying a label (JSON object).
# KE_LABEL_NOTICES={"synthetic": "Synthetic test data — not real facts."}

KE_MODEL_TIMEOUT=180
KE_JOB_TIMEOUT=1800
KE_MAX_UPLOAD_BYTES=20971520
KE_MAX_JOBS=32
KE_MAX_CHUNKS=600

# Browser origins allowed to call the API (JSON list). Writes from any other origin get 403.
KE_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Host names the API answers to (blocks DNS rebinding); add one only if you reach the API by it.
# KE_ALLOWED_HOSTS=["127.0.0.1","localhost"]

# Tests only (read from the shell environment, not this file): each test gets its own schema.
# KE_TEST_DATABASE_URL=postgresql://localhost:5432/knowledge_engine_test
